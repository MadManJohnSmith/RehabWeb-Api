# Copiar a `.env` en la raíz del repo (no commitear `.env`).
# Valores de ejemplo para desarrollo local.

DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (opcional; por defecto coinciden con XAMPP local)
# MYSQL_DATABASE=rehab_db
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Reutilización de conexiones (solo MySQL en runtime)
# DB_CONN_MAX_AGE=60

# Orígenes CORS adicionales (coma-separados), p. ej. staging o prod
# DJANGO_CORS_EXTRA_ORIGINS=https://app.ejemplo.com
